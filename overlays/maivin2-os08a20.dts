// Maivin 1 camera Overlay for the OS08A20 Sensor

/dts-v1/;
/plugin/;

#include <dt-bindings/clock/imx8mp-clock.h>
#include <dt-bindings/gpio/gpio.h>

#include "imx8mp-pinfunc.h"

/ {
	compatible = "toradex,verdin-imx8mp";
};

/* Verdin I2C_2_CSI */
&i2c2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	os08a20_landscape: os08a20_mipi@36 {
		compatible = "ovti,os08a20";
		reg = <0x36>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_csi2_control>;
		DVDD-supply = <&csi_3v3>;
		clocks = <&clk_dummy>;
		clock-names = "csi_mclk";
		mclk = <24000000>;
		mclk_source = <0>;
		csi_id = <1>;
		status = "okay";

		rst-gpios = <&gpio4 3 GPIO_ACTIVE_LOW>;
		pwn-gpios = <&gpio4 1 GPIO_ACTIVE_HIGH>;

		port {
			os08a20_mipi_1_ep: endpoint {
				data-lanes = <1 2 3 4>;
				clock-lanes = <0>;
				max-pixel-frequency = /bits/ 64 <500000000>;
				remote-endpoint = <&mipi_csi1_ep>;
			};
		};
	};
};

/* Verdin I2C_4_CSI */
&i2c3 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	os08a20_portrait: os08a20_mipi@36 {
		compatible = "ovti,os08a20";
		reg = <0x36>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_csi1_control>;
		DVDD-supply = <&csi_3v3>;
		clocks = <&clk_dummy>;
		clock-names = "csi_mclk";
		mclk = <24000000>;
		mclk_source = <0>;
		csi_id = <0>;
		status = "okay";

		rst-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
		pwn-gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;

		port {
			os08a20_mipi_0_ep: endpoint {
				data-lanes = <1 2 3 4>;
				clock-lanes = <0>;
				max-pixel-frequency = /bits/ 64 <500000000>;
				remote-endpoint = <&mipi_csi0_ep>;
			};
		};
	};
};

&mipi_csi_0 {
	#address-cells = <1>;
	#size-cells = <0>;
	/*
	 * 266MHz / SYS_PLL1_266M matches NXP's own dual-OS08A20 reference
	 * (imx8mp-evk-dual-os08a20.dts). IMX8MP_CLK_MEDIA_CAM2_PIX (used by
	 * mipi_csi_1 below) is hard-capped at 277MHz by the SoC (enforced by
	 * upstream kernel commit "clk: imx8mp: inform CCF of maximum
	 * frequency of clocks", landed in Torizon's 6.6.94 kernel bump).
	 * Both ports previously requested 500000000/SYS_PLL2_1000M, which
	 * silently got clamped to 250MHz on CAM2_PIX once that cap was
	 * enforced, starving the CSI-2 receiver and collapsing capture FPS.
	 */
	clock-frequency = <266000000>;
	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_266M>;
	assigned-clock-rates = <266000000>;
	status = "okay";

	port@0 {
		reg = <0>;
		mipi_csi0_ep: endpoint {
			remote-endpoint = <&os08a20_mipi_0_ep>;
			data-lanes = <4>;
			csis-hs-settle = <16>;
			csis-clk-settle = <2>;
			csis-wclk;
		};
	};
};

&mipi_csi_1 {
	#address-cells = <1>;
	#size-cells = <0>;
	/* See &mipi_csi_0 above: IMX8MP_CLK_MEDIA_CAM2_PIX is capped at
	 * 277MHz by the SoC; 266MHz matches NXP's dual-OS08A20 reference. */
	clock-frequency = <266000000>;
	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_266M>;
	assigned-clock-rates = <266000000>;
	status = "okay";

	port@1 {
		reg = <1>;
		mipi_csi1_ep: endpoint {
			remote-endpoint = <&os08a20_mipi_1_ep>;
			data-lanes = <4>;
			csis-hs-settle = <16>;
			csis-clk-settle = <2>;
			csis-wclk;
		};
	};
};
